# Copy to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=3000

# development | production
NODE_ENV=development

# MongoDB Atlas connection string.
# mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/social?retryWrites=true&w=majority
MONGO_URI=

# Clerk -> Dashboard -> API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk -> Dashboard -> Webhooks -> your endpoint -> Signing Secret (starts with whsec_)
# Endpoint URL: https://<your-deployed-domain>/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# ImageKit -> Dashboard -> Developer Options -> API Keys -> Private key
IMAGEKIT_PRIVATE_KEY=

# Origin allowed by CORS. Vite dev server default is http://localhost:5173
# In production set this to your deployed site URL.
FRONTEND_URL=http://localhost:5173
